<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#FFFFFF">

        <!-- Top Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_menu"
                android:background="@android:color/transparent" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Achievements"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center" />

        </LinearLayout>

        <!-- Stats Summary -->
        <TextView
            android:id="@+id/tvStatsSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="WALLET WISE"
            android:textSize="14sp"
            android:textColor="#666666"
            android:gravity="center"
            android:padding="12dp"
            android:background="#F5F5F5"
            android:layout_margin="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🏆 Unlocked Achievements"
            android:textSize="16sp"
            android:textStyle="bold"
            android:padding="16dp"
            android:background="#E8F5E9" />

        <ListView
            android:id="@+id/lvUnlockedAchievements"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="#E5E5E5"
            android:dividerHeight="1dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔒 Locked Achievements"
            android:textSize="16sp"
            android:textStyle="bold"
            android:padding="16dp"
            android:background="#FFEBEE" />

        <ListView
            android:id="@+id/lvLockedAchievements"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="#E5E5E5"
            android:dividerHeight="1dp" />

    </LinearLayout>

    <!-- Navigation Drawer -->
    <LinearLayout
        android:id="@+id/navView"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:elevation="16dp"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Menu"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/navExpenseList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Expense List"
            android:backgroundTint="#2136F3"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/navViewGoals"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="View Goals"
            android:backgroundTint="#4CAF50"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/navSetGoals"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Set Goals"
            android:backgroundTint="#FF9800"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/navCreateCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Create Category"
            android:backgroundTint="#9C27B0"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/navViewCategories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="View Categories"
            android:backgroundTint="#2196F3"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/navProjectionCalendar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Projection Calendar"
            android:backgroundTint="#E91E63"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/navGamification"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Achievements"
            android:backgroundTint="#FF5722"
            android:textColor="#FFFFFF" />

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>