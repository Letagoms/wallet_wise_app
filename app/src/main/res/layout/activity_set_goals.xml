<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Set Your Goals"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp" />

    <!-- Minimum Goal -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Minimum Goal (R)"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etMinimumGoal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="e.g., 1000"
        android:inputType="number"
        android:padding="12dp"
        android:background="#F5F5F5"
        android:layout_marginBottom="16dp" />

    <!-- Maximum Goal -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Maximum Goal (R)"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etMaximumGoal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="e.g., 5000"
        android:inputType="number"
        android:padding="12dp"
        android:background="#F5F5F5"
        android:layout_marginBottom="24dp" />

    <!-- Set Goals Button -->
    <Button
        android:id="@+id/btnSetGoals"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Set Goals"
        android:backgroundTint="#2136F3"
        android:textColor="#FFFFFF" />

    <!-- View Goals Button -->
    <Button
        android:id="@+id/btnViewGoals"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="View My Goals"
        android:backgroundTint="#4CAF50"
        android:textColor="#FFFFFF"
        android:layout_marginTop="12dp" />

</LinearLayout>