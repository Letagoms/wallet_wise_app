<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_menu"
            android:background="@android:color/transparent"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Set Your Goals"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="32dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Minimum Goal (R)"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etMinimumGoal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g., 1000"
            android:inputType="number"
            android:padding="12dp"
            android:background="#F5F5F5"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Maximum Goal (R)"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etMaximumGoal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g., 5000"
            android:inputType="number"
            android:padding="12dp"
            android:background="#F5F5F5"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnSetGoals"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Set Goals"
            android:backgroundTint="#2136F3"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnViewGoals"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="View My Goals"
            android:backgroundTint="#4CAF50"
            android:textColor="#FFFFFF"
            android:layout_marginTop="12dp" />

    </LinearLayout>

    <!-- Navigation Drawer -->
    <LinearLayout
        android:id="@+id/navView"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:elevation="16dp"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Menu"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/navExpenseList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Expense List"
            android:backgroundTint="#2136F3"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/navViewGoals"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="View Goals"
            android:backgroundTint="#4CAF50"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/navSetGoals"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Set Goals"
            android:backgroundTint="#FF9800"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/navCreateCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Create Category"
            android:backgroundTint="#9C27B0"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/navViewCategories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="View Categories"
            android:backgroundTint="#2196F3"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/navProjectionCalendar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Projection Calendar"
            android:backgroundTint="#E91E63"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>