<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!--TOP ROW: Icon + Name/Status + Amount-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Colored rounded-square icon background -->
            <LinearLayout
                android:id="@+id/iconBackground"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_icon_rounded">

                <ImageView
                    android:id="@+id/categoryIcon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_home"
                    android:tint="#FFFFFF"
                    android:contentDescription="Category Icon" />
            </LinearLayout>

            <!-- Name + remaining/over-budget text (takes remaining space) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/categoryName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Category Name"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A2E" />

                <TextView
                    android:id="@+id/categoryStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="R0.00 remaining"
                    android:textSize="12sp"
                    android:textColor="#8A8FA8"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Right side: spent amount + goal range -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:id="@+id/categorySpent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="R0.00"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A2E"
                    android:gravity="end" />

                <TextView
                    android:id="@+id/categoryGoal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="of R0.00–R0.00"
                    android:textSize="11sp"
                    android:textColor="#8A8FA8"
                    android:gravity="end"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

        </LinearLayout>

        <!--PROGRESS BAR -->
        <ProgressBar
            android:id="@+id/categoryProgress"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="12dp"
            android:max="100"
            android:progress="50"
            android:progressDrawable="@drawable/progress_bar_blue"
            android:indeterminate="false" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
